# Copy to watchtower.env on the NAS (same folder as docker-compose.yml). Never commit watchtower.env.
# Copy the notification URL from /volume1/docker/wine-cellar/watchtower.env and change the path to /message/groly
# (or /message/watchtower to reuse the existing channel). Shoutrrr generic webhook format, e.g.:
WATCHTOWER_NOTIFICATIONS=shoutrrr
WATCHTOWER_NOTIFICATION_URL=
