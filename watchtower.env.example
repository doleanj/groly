# Copy to watchtower.env on the NAS (same folder as docker-compose.yml). Never commit watchtower.env.
# The API token and HTTP API switches are NOT here: they come from the shared /volume1/docker/secrets/watchtower.env
# (created and rotated by synology-chat-webhook/deploy/nas-watchtower-token.sh). Only the notification settings live here.
# Same values as the wine-cellar project's watchtower.env, with the path /message/groly (needs a "groly" token in the bridge's synology.tokens).
WATCHTOWER_NOTIFICATIONS=shoutrrr
WATCHTOWER_NOTIFICATION_URL=
