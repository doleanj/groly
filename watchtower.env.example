# Copy to watchtower.env on the NAS (same folder as docker-compose.yml). Never commit watchtower.env.
# Same values as /volume1/docker/wine-cellar/watchtower.env, except the notification path (/message/groly).
WATCHTOWER_NOTIFICATIONS=shoutrrr
WATCHTOWER_NOTIFICATION_URL=
# REQUIRED: nickfedor/watchtower exits at start ("API token is empty or unset") if this is empty, even though the HTTP API is not published.
WATCHTOWER_HTTP_API_TOKEN=
