# Copy to watchtower.env on the NAS (same folder as docker-compose.yml). Never commit watchtower.env.
# Project settings only. The token and HTTP API switches come from the shared /volume1/docker/secrets/watchtower.env
# (generated and rotated by synology-chat-webhook/deploy/nas-watchtower-token.sh), which is loaded last.
# Take the values from another project's watchtower.env (e.g. wine-cellar) and change the path to /message/groly.
# The bridge must route "groly": add it under clients.watchtower-nas.routes (and config.release_notes: doleanj/groly) in config.json.
WATCHTOWER_NOTIFICATIONS=shoutrrr
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_HTTP_API_ENDPOINTS=
